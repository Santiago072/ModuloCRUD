# ============================================================
# Variables de Entorno — Módulo CRUD
# Copia este archivo como .env y completa con tus valores reales.
# NUNCA subas el archivo .env a GitHub.
# ============================================================

# -- Base de Datos --
DB_HOST=db
DB_NAME=modulocrud
DB_USER=crud_user
DB_PASSWORD=CAMBIA_ESTA_CLAVE_SEGURA

# -- Backend Node.js --
PORT=3000

# -- Seguridad JWT (OBLIGATORIO) --
# Genera una clave aleatoria segura con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTA_CLAVE_JWT_SEGURA_Y_LARGA

# -- CORS: Orígenes autorizados (OBLIGATORIO) --
# Lista separada por comas, sin espacios. Incluye tu dominio de producción
# y localhost para desarrollo. Ejemplo:
ALLOWED_ORIGINS=https://modulocrud.slscode.online,http://localhost:8893

# -- URL de la API (usada por el Frontend en build) --
# En producción (VPS): https://modulocrud.slscode.online/api
# En desarrollo local: http://localhost:3000/api
VITE_API_URL=https://modulocrud.slscode.online/api
